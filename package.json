{
  "name": "simstart",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/cloudflare.mjs dev",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/cloudflare.mjs deploy --dry-run --outdir work/dry-run",
    "login": "node scripts/cloudflare.mjs login",
    "whoami": "node scripts/cloudflare.mjs whoami",
    "db:local": "node scripts/cloudflare.mjs d1 migrations apply DB --local",
    "db:remote": "node scripts/cloudflare.mjs d1 migrations apply DB --remote",
    "seed:prepare": "node scripts/prepare-seed.mjs",
    "deploy": "node scripts/deploy.mjs"
  },
  "devDependencies": {"wrangler":"4.156.0"}
}
