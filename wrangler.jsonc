{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "simstart",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "simstart-nav",
    "migrations_dir": "migrations"
  }],
  "triggers": {"crons": ["0 * * * *"]},
  "vars": {"MAX_STORED_FUNDS": "20"},
  "observability": {"enabled": false}
}
