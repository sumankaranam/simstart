{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "simstart",
	"main": "worker.mjs",
	"compatibility_date": "2026-11-01",
	"workers_dev": true,
	"preview_urls": false,
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "simstart-nav",
			"migrations_dir": "migrations",
			"database_id": "b8fded86-a9b0-4ef8-8baf-7d61b62fb4d6"
		}
	],
	"triggers": {
		"crons": [
			"0 * * * *"
		]
	},
	"vars": {
		"MAX_STORED_FUNDS": "20"
	},
	"observability": {
		"enabled": false
	}
}